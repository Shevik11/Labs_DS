CALL () {
UNWIND [{`id`:"data:hourlyDataset",`labels`:["Dataset","Lab8Entity"],`properties`:{`scope`:"lab8_energy",`name`:"Браузерний фрагмент: 2009-09-09",`recordCount`:24,`source`:"lab1/hourly_clean.csv",`sourceURI`:"https://archive.ics.uci.edu/dataset/235/individualhouseholdelectricpowerconsumption",`license`:"CC BY 4.0"}}] AS row
MERGE (n:Lab8Entity {id: row.id})
SET n += row.properties
SET n:Dataset
RETURN count(*) AS n0
}
CALL () {
UNWIND [{`id`:"data:hourlyPeriod",`labels`:["Lab8Entity","TimeInterval"],`properties`:{`scope`:"lab8_energy",`name`:"Одна доба браузерного фрагмента",`startTime`:"2009-09-09T00:00:00",`endTime`:"2009-09-10T00:00:00",`timeContext`:"Час джерела без UTC-зсуву; localdatetime, не Europe/Kyiv"}}] AS row
MERGE (n:Lab8Entity {id: row.id})
SET n += row.properties
SET n:TimeInterval
SET n.endTime = localdatetime(row.properties.endTime)
SET n.startTime = localdatetime(row.properties.startTime)
RETURN count(*) AS n1
}
CALL () {
UNWIND [{`id`:"data:hourlySeries",`labels`:["Lab8Entity","TimeSeries"],`properties`:{`scope`:"lab8_energy",`name`:"Годинний ряд браузерного фрагмента",`stepMinutes`:60,`missingCount`:0,`source`:"lab1/hourly_clean.csv"}}] AS row
MERGE (n:Lab8Entity {id: row.id})
SET n += row.properties
SET n:TimeSeries
RETURN count(*) AS n2
}
CALL () {
UNWIND [{`id`:"forecast:2009-09-09T20:00:00",`labels`:["AnalysisResult","ForecastResult","HighConsumptionForecast","Lab8Entity","Lab8Forecast"],`properties`:{`scope`:"lab8_energy",`name`:"Прогноз 2009-09-09T20:00:00",`targetTime`:"2009-09-09T20:00:00",`forecastKwh`:1.9519405504171758,`actualKwh`:2.12,`persistenceKwh`:1.5702666666666665,`actualHigh`:1,`predictedHigh`:0,`probabilityHigh`:0.47241366291674264,`highByRegression`:true,`source`:"lab1/test_predictions.csv",`thresholdKwh`:1.5613}},{`id`:"forecast:2009-09-09T21:00:00",`labels`:["AnalysisResult","ForecastResult","HighConsumptionForecast","Lab8Entity","Lab8Forecast"],`properties`:{`scope`:"lab8_energy",`name`:"Прогноз 2009-09-09T21:00:00",`targetTime`:"2009-09-09T21:00:00",`forecastKwh`:2.2062409859434897,`actualKwh`:2.6363,`persistenceKwh`:2.12,`actualHigh`:1,`predictedHigh`:1,`probabilityHigh`:0.8164990437730075,`highByRegression`:true,`source`:"lab1/test_predictions.csv",`thresholdKwh`:1.5613}}] AS row
MERGE (n:Lab8Entity {id: row.id})
SET n += row.properties
SET n:AnalysisResult:ForecastResult:HighConsumptionForecast:Lab8Forecast
SET n.targetTime = localdatetime(row.properties.targetTime)
RETURN count(*) AS n3
}
CALL () {
UNWIND [{`id`:"forecast:2009-09-09T22:00:00",`labels`:["AnalysisResult","ForecastResult","Lab8Entity","Lab8Forecast","NonHighConsumptionForecast"],`properties`:{`scope`:"lab8_energy",`name`:"Прогноз 2009-09-09T22:00:00",`targetTime`:"2009-09-09T22:00:00",`forecastKwh`:1.4170612634677764,`actualKwh`:2.074333333333333,`persistenceKwh`:2.6363,`actualHigh`:1,`predictedHigh`:1,`probabilityHigh`:0.7657932966314938,`highByRegression`:false,`source`:"lab1/test_predictions.csv",`thresholdKwh`:1.5613}},{`id`:"forecast:2009-09-09T23:00:00",`labels`:["AnalysisResult","ForecastResult","Lab8Entity","Lab8Forecast","NonHighConsumptionForecast"],`properties`:{`scope`:"lab8_energy",`name`:"Прогноз 2009-09-09T23:00:00",`targetTime`:"2009-09-09T23:00:00",`forecastKwh`:0.7732185389614643,`actualKwh`:0.31143333333333334,`persistenceKwh`:2.074333333333333,`actualHigh`:0,`predictedHigh`:0,`probabilityHigh`:0.12481500996064657,`highByRegression`:false,`source`:"lab1/test_predictions.csv",`thresholdKwh`:1.5613}}] AS row
