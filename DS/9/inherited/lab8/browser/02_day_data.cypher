CALL () {
UNWIND [{`source`:"forecast:2009-09-09T20:00:00",`type`:"COMPARED_WITH",`target`:"measurement:2009-09-09T20:00:00",`properties`:{`provenance`:"lab8_extension"}},{`source`:"forecast:2009-09-09T21:00:00",`type`:"COMPARED_WITH",`target`:"measurement:2009-09-09T21:00:00",`properties`:{`provenance`:"lab8_extension"}},{`source`:"forecast:2009-09-09T22:00:00",`type`:"COMPARED_WITH",`target`:"measurement:2009-09-09T22:00:00",`properties`:{`provenance`:"lab8_extension"}},{`source`:"forecast:2009-09-09T23:00:00",`type`:"COMPARED_WITH",`target`:"measurement:2009-09-09T23:00:00",`properties`:{`provenance`:"lab8_extension"}}] AS row
MATCH (a:Lab8Entity {id: row.source})
MATCH (b:Lab8Entity {id: row.target})
MERGE (a)-[r:COMPARED_WITH]->(b)
SET r += row.properties
RETURN count(*) AS r0
}
