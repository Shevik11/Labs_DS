MATCH (a:Lab8Entity:OntologyIndividual {id:$pathStart}),
      (b:Lab8Entity:OntologyIndividual {id:$pathEnd})
MATCH p=shortestPath((a)-[:ANALYZES_SERIES|BASED_ON_MODEL|BELONGS_TO_DATASET|CONFIGURES|CONTAINS_SERIES|COVERS_INTERVAL|CREATES_VISUALIZATION|DERIVED_FROM_SERIES|DISPLAYS_SERIES|EVALUATED_BY|GENERATED_BY|HAS_MEASUREMENT|HAS_METER|HAS_UNIT|IMPLEMENTED_BY|INSTALLED_AT|MAKES_DECISION|MEASUREMENT_OF|OBSERVES_INDICATOR|PRESENTED_IN|PRESENTS_RESULT|PROCESSES|PRODUCES_RESULT|RECORDED_BY|RECORDS|SERIES_INDICATOR|SERIES_OF|SUPPORTS_DECISION|USES_MODULE|VIEWS|VISUALIZATION_OF*1..8]-(b))
WHERE all(n IN nodes(p) WHERE n:OntologyIndividual)
RETURN p, length(p) AS hops,
       [n IN nodes(p) | n.id] AS node_ids,
       [r IN relationships(p) | type(r)] AS relationship_types;
