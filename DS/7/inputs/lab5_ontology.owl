  <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#regressor">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#RegressionModel"/>
    <rdfs:label xml:lang="uk">Random Forest із ЛР1</rdfs:label>
    <energy:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">regressor</energy:identifier>
    <energy:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Random Forest із ЛР1</energy:name>
    <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
    <energy:algorithm rdf:datatype="http://www.w3.org/2001/XMLSchema#string">RandomForestRegressor</energy:algorithm>
    <energy:modelVersion rdf:datatype="http://www.w3.org/2001/XMLSchema#string">lab1</energy:modelVersion>
    <energy:analyzesSeries rdf:resource="https://example.org/lnu/energy-visualization#predictionSeries"/>
    <energy:producesResult rdf:resource="https://example.org/lnu/energy-visualization#forecast"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#forecast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#ForecastResult"/>
    <rdfs:label xml:lang="uk">Прогноз із ЛР1</rdfs:label>
    <energy:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forecast</energy:identifier>
    <energy:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прогноз із ЛР1</energy:name>
    <rdfs:comment xml:lang="uk">Реальний збережений прогноз ЛР1; модель у ЛР5 повторно не навчалася. derivedFromSeries позначає цільовий ряд, а не перелік лагових ознак.</rdfs:comment>
    <energy:resultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.9519405504171758</energy:resultValue>
    <energy:forecastKwh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.9519405504171758</energy:forecastKwh>
    <energy:targetTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-09T20:00:00</energy:targetTime>
    <energy:derivedFromSeries rdf:resource="https://example.org/lnu/energy-visualization#predictionSeries"/>
    <energy:presentedIn rdf:resource="https://example.org/lnu/energy-visualization#forecastChart"/>
    <energy:evaluatedBy rdf:resource="https://example.org/lnu/energy-visualization#mae"/>
  </rdf:Description>
