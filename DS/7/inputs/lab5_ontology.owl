  <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#mae">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#QualityMetric"/>
    <rdfs:label xml:lang="uk">MAE регресії ЛР1</rdfs:label>
    <energy:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">mae</energy:identifier>
    <energy:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">MAE регресії ЛР1</energy:name>
    <rdfs:comment xml:lang="uk">Значення metrics.json ЛР1 для всієї тестової вибірки, не похибка одного прогнозу.</rdfs:comment>
    <energy:metricValue rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0.3359660136113589</energy:metricValue>
    <energy:metricUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kWh</energy:metricUnit>
    <energy:evaluationScope rdf:datatype="http://www.w3.org/2001/XMLSchema#string">9530 тестових прогнозів ЛР1; 2009-09-09 — 2010-11-26</energy:evaluationScope>
  </rdf:Description>
