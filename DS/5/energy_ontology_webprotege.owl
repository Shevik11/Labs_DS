<?xml version="1.0"?>
<rdf:RDF xmlns="https://example.org/lnu/energy-visualization#"
     xml:base="https://example.org/lnu/energy-visualization"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:energy-visualization="https://example.org/lnu/energy-visualization#">
    <owl:Ontology rdf:about="https://example.org/lnu/energy-visualization">
        <rdfs:comment xml:lang="uk">ЛНУ, лабораторна №5. Варіант: Енергетика / Програмне забезпечення / Візуалізація. IRI example.org є навчальним ідентифікатором, а не опублікованим сервісом.</rdfs:comment>
        <rdfs:label xml:lang="uk">Онтологія візуалізації енергетичних даних</rdfs:label>
        <owl:versionInfo>1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- https://example.org/lnu/energy-visualization#topicGroup -->

    <owl:AnnotationProperty rdf:about="https://example.org/lnu/energy-visualization#topicGroup">
        <rdfs:label xml:lang="uk">Тематична група ЛР4</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
