     -->

    


    <!-- https://example.org/lnu/energy-visualization#AnalysisResult -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#AnalysisResult">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Результат застосування моделі до даних: значення прогнозу, мітка класу чи кластер.</rdfs:comment>
        <rdfs:label xml:lang="uk">Результат аналізу</rdfs:label>
        <topicGroup xml:lang="uk">Аналітика</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#AnalysisTask -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#AnalysisTask">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Постановка аналізу з визначеними входами, очікуваним результатом і критеріями оцінювання.</rdfs:comment>
        <rdfs:label xml:lang="uk">Аналітичне завдання</rdfs:label>
        <topicGroup xml:lang="uk">Аналітика</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Analyst -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Analyst">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#User"/>
        <rdfs:label xml:lang="uk">Аналітик</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#AnalyticalModel -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#AnalyticalModel">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Метод із визначеними параметрами, який виконує аналітичне завдання.</rdfs:comment>
        <rdfs:label xml:lang="uk">Аналітична модель</rdfs:label>
        <topicGroup xml:lang="uk">Аналітика</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ClassificationModel -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ClassificationModel">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalyticalModel"/>
        <rdfs:label xml:lang="uk">Модель класифікації</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ClassificationResult -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ClassificationResult">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalysisResult"/>
        <rdfs:label xml:lang="uk">Результат класифікації</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ClusterResult -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ClusterResult">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalysisResult"/>
        <rdfs:label xml:lang="uk">Результат кластеризації</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ClusteringModel -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ClusteringModel">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalyticalModel"/>
        <rdfs:label xml:lang="uk">Модель кластеризації</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ConsumptionObject -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ConsumptionObject">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Фізичний об’єкт, для якого аналізують споживання електроенергії.</rdfs:comment>
        <rdfs:label xml:lang="uk">Об’єкт споживання</rdfs:label>
        <topicGroup xml:lang="uk">Енергетичний контекст</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Dataset -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Dataset">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#containsSeries"/>
                <owl:someValuesFrom rdf:resource="https://example.org/lnu/energy-visualization#TimeSeries"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="uk">Сукупність спостережень, підготовлених для аналізу.</rdfs:comment>
        <rdfs:label xml:lang="uk">Набір даних</rdfs:label>
        <topicGroup xml:lang="uk">Дані споживання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Decision -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Decision">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Висновок або дія, яку користувач обирає після інтерпретації візуалізації.</rdfs:comment>
        <rdfs:label xml:lang="uk">Рішення користувача</rdfs:label>
        <topicGroup xml:lang="uk">Використання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#DomainEntity -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#DomainEntity">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#identifier"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#name"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="uk">Сутність предметної області</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#EnergyIndicator -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#EnergyIndicator">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Величина, яку спостерігають або обчислюють; енергію за годину отримують агрегуванням.</rdfs:comment>
        <rdfs:label xml:lang="uk">Енергетичний показник</rdfs:label>
        <topicGroup xml:lang="uk">Енергетичний контекст</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#EnergyMeasurement -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#EnergyMeasurement">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#Measurement"/>
        <rdfs:label xml:lang="uk">Вимірювання енергії</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ForecastResult -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ForecastResult">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalysisResult"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#generatedBy"/>
                <owl:someValuesFrom rdf:resource="https://example.org/lnu/energy-visualization#RegressionModel"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#forecastKwh"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#targetTime"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="uk">Прогноз наступної години</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ForecastVisualization -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ForecastVisualization">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#Visualization"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#presentsResult"/>
                        <owl:someValuesFrom rdf:resource="https://example.org/lnu/energy-visualization#ForecastResult"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#Visualization"/>
        <rdfs:label xml:lang="uk">Візуалізація прогнозу</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Heatmap -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Heatmap">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#Visualization"/>
        <rdfs:label xml:lang="uk">Теплова карта</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Household -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Household">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#ConsumptionObject"/>
        <rdfs:label xml:lang="uk">Домогосподарство</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#LineChart -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#LineChart">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#Visualization"/>
        <rdfs:label xml:lang="uk">Лінійний графік</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Measurement -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Measurement">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#hasUnit"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#observesIndicator"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#recordedBy"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#numericValue"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#qualityFlag"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#timestamp"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="uk">Спостереження показника з часовою міткою, значенням, одиницею та ознакою якості.</rdfs:comment>
        <rdfs:label xml:lang="uk">Вимірювання</rdfs:label>
        <topicGroup xml:lang="uk">Дані споживання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Meter -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Meter">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Засіб отримання вимірювань енергоспоживання об’єкта.</rdfs:comment>
        <rdfs:label xml:lang="uk">Засіб обліку</rdfs:label>
        <topicGroup xml:lang="uk">Енергетичний контекст</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#QualityMetric -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#QualityMetric">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Числова оцінка результату із зазначенням задачі й вибірки оцінювання.</rdfs:comment>
        <rdfs:label xml:lang="uk">Метрика якості</rdfs:label>
        <topicGroup xml:lang="uk">Аналітика</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#RegressionModel -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#RegressionModel">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#AnalyticalModel"/>
        <rdfs:label xml:lang="uk">Регресійна модель</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#SoftwareModule -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#SoftwareModule">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Компонент програми, який перевіряє й перетворює дані та формує їх візуальне подання.</rdfs:comment>
        <rdfs:label xml:lang="uk">Програмний модуль</rdfs:label>
        <topicGroup xml:lang="uk">Програмне подання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Submeter -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Submeter">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#Meter"/>
        <rdfs:label xml:lang="uk">Підлічильник</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#TimeInterval -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#TimeInterval">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Проміжок часу, до якого належать спостереження або результати.</rdfs:comment>
        <rdfs:label xml:lang="uk">Часовий інтервал</rdfs:label>
        <topicGroup xml:lang="uk">Дані споживання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#TimeSeries -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#TimeSeries">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#hasMeasurement"/>
                <owl:someValuesFrom rdf:resource="https://example.org/lnu/energy-visualization#Measurement"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#coversInterval"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#seriesIndicator"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#seriesOf"/>
                <owl:cardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:cardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="uk">Упорядковані за часом вимірювання одного показника одного об’єкта.</rdfs:comment>
        <rdfs:label xml:lang="uk">Часовий ряд</rdfs:label>
        <topicGroup xml:lang="uk">Дані споживання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Unit -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Unit">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:label xml:lang="uk">Одиниця вимірювання</rdfs:label>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#User -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#User">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Особа, яка переглядає графіки, налаштовує відбір і використовує результати.</rdfs:comment>
        <rdfs:label xml:lang="uk">Користувач</rdfs:label>
        <topicGroup xml:lang="uk">Використання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#ViewFilter -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#ViewFilter">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:comment xml:lang="uk">Умова відбору або групування інформації, яка показана на візуалізації.</rdfs:comment>
        <rdfs:label xml:lang="uk">Фільтр подання</rdfs:label>
        <topicGroup xml:lang="uk">Програмне подання</topicGroup>
    </owl:Class>
    


    <!-- https://example.org/lnu/energy-visualization#Visualization -->

    <owl:Class rdf:about="https://example.org/lnu/energy-visualization#Visualization">
        <rdfs:subClassOf rdf:resource="https://example.org/lnu/energy-visualization#DomainEntity"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://example.org/lnu/energy-visualization#displaysSeries"/>
                <owl:someValuesFrom rdf:resource="https://example.org/lnu/energy-visualization#TimeSeries"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="uk">Графічне подання спостережень або аналітичного результату з підписами та одиницями.</rdfs:comment>
        <rdfs:label xml:lang="uk">Візуалізація</rdfs:label>
        <topicGroup xml:lang="uk">Програмне подання</topicGroup>
    </owl:Class>
    


