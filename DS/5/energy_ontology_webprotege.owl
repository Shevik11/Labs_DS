    <!-- https://example.org/lnu/energy-visualization#measurement3 -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#measurement3">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#EnergyMeasurement"/>
        <hasUnit rdf:resource="https://example.org/lnu/energy-visualization#kWh"/>
