    <!-- https://example.org/lnu/energy-visualization#analyst -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#analyst">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#Analyst"/>
        <makesDecision rdf:resource="https://example.org/lnu/energy-visualization#decision"/>
        <usesModule rdf:resource="https://example.org/lnu/energy-visualization#module"/>
        <views rdf:resource="https://example.org/lnu/energy-visualization#forecastChart"/>
        <views rdf:resource="https://example.org/lnu/energy-visualization#heatmap"/>
        <views rdf:resource="https://example.org/lnu/energy-visualization#lineChart"/>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyst</identifier>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Демонстраційний аналітик</name>
        <role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">аналітик</role>
        <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
        <rdfs:label xml:lang="uk">Демонстраційний аналітик</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://example.org/lnu/energy-visualization#dataset -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#dataset">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#Dataset"/>
        <containsSeries rdf:resource="https://example.org/lnu/energy-visualization#series"/>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">dataset</identifier>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Три години з ЛР1</name>
        <recordCount rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">3</recordCount>
        <sourceURI rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://doi.org/10.24432/C58K54</sourceURI>
        <rdfs:comment xml:lang="uk">Перші три рядки hourly_clean.csv ЛР1, без повторного очищення.</rdfs:comment>
        <rdfs:label xml:lang="uk">Три години з ЛР1</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://example.org/lnu/energy-visualization#decision -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#decision">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#Decision"/>
        <decisionText rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Переглянути профіль споживання перед прийняттям рішення.</decisionText>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">decision</identifier>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Перевірка режиму споживання</name>
        <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
        <rdfs:label xml:lang="uk">Перевірка режиму споживання</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://example.org/lnu/energy-visualization#energy -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#energy">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#EnergyIndicator"/>
        <aggregationMethod rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Сума хвилинної активної потужності / 60 для повної години</aggregationMethod>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">energy</identifier>
        <indicatorUnit rdf:datatype="http://www.w3.org/2001/XMLSchema#string">kWh</indicatorUnit>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Енергія за годину</name>
        <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
        <rdfs:label xml:lang="uk">Енергія за годину</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://example.org/lnu/energy-visualization#filter -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#filter">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#ViewFilter"/>
        <configures rdf:resource="https://example.org/lnu/energy-visualization#lineChart"/>
        <filterCondition rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2006-12-16 18:00 &lt;= timestamp &lt; 2006-12-16 21:00</filterCondition>
        <filterField rdf:datatype="http://www.w3.org/2001/XMLSchema#string">timestamp</filterField>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">filter</identifier>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Відбір за періодом</name>
        <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
        <rdfs:label xml:lang="uk">Відбір за періодом</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://example.org/lnu/energy-visualization#forecast -->

    <owl:NamedIndividual rdf:about="https://example.org/lnu/energy-visualization#forecast">
        <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#ForecastResult"/>
        <derivedFromSeries rdf:resource="https://example.org/lnu/energy-visualization#predictionSeries"/>
        <evaluatedBy rdf:resource="https://example.org/lnu/energy-visualization#mae"/>
        <presentedIn rdf:resource="https://example.org/lnu/energy-visualization#forecastChart"/>
        <forecastKwh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.9519405504171758</forecastKwh>
        <identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">forecast</identifier>
        <name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Прогноз із ЛР1</name>
        <resultValue rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.9519405504171758</resultValue>
        <targetTime rdf:datatype="http://www.w3.org/2001/XMLSchema#dateTime">2009-09-09T20:00:00</targetTime>
        <rdfs:comment xml:lang="uk">Реальний збережений прогноз ЛР1; модель у ЛР5 повторно не навчалася. derivedFromSeries позначає цільовий ряд, а не перелік лагових ознак.</rdfs:comment>
        <rdfs:label xml:lang="uk">Прогноз із ЛР1</rdfs:label>
    </owl:NamedIndividual>
    


