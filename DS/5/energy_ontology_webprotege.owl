    <!-- https://example.org/lnu/energy-visualization#analyzesSeries -->

    <owl:ObjectProperty rdf:about="https://example.org/lnu/energy-visualization#analyzesSeries">
        <rdfs:domain rdf:resource="https://example.org/lnu/energy-visualization#AnalyticalModel"/>
        <rdfs:range rdf:resource="https://example.org/lnu/energy-visualization#TimeSeries"/>
        <rdfs:label xml:lang="uk">аналізує</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lnu/energy-visualization#belongsToDataset -->

    <owl:ObjectProperty rdf:about="https://example.org/lnu/energy-visualization#belongsToDataset">
        <owl:inverseOf rdf:resource="https://example.org/lnu/energy-visualization#containsSeries"/>
        <rdfs:domain rdf:resource="https://example.org/lnu/energy-visualization#TimeSeries"/>
        <rdfs:range rdf:resource="https://example.org/lnu/energy-visualization#Dataset"/>
        <rdfs:label xml:lang="uk">Обернене: містить</rdfs:label>
    </owl:ObjectProperty>
    


