        <rdfs:range rdf:resource="https://example.org/lnu/energy-visualization#Visualization"/>
        <rdfs:label xml:lang="uk">налаштовує</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://example.org/lnu/energy-visualization#containsSeries -->

    <owl:ObjectProperty rdf:about="https://example.org/lnu/energy-visualization#containsSeries">
