  <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#analyst">
    <ns1:name rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Демонстраційний аналітик</ns1:name>
    <rdfs:label xml:lang="uk">Демонстраційний аналітик</rdfs:label>
    <rdfs:comment xml:lang="uk">Демонстраційний екземпляр структури системи; не факт із набору UCI.</rdfs:comment>
    <ns1:role rdf:datatype="http://www.w3.org/2001/XMLSchema#string">аналітик</ns1:role>
    <ns1:usesModule rdf:resource="https://example.org/lnu/energy-visualization#module"/>
    <ns1:views rdf:resource="https://example.org/lnu/energy-visualization#heatmap"/>
    <ns1:views rdf:resource="https://example.org/lnu/energy-visualization#lineChart"/>
    <ns1:views rdf:resource="https://example.org/lnu/energy-visualization#forecastChart"/>
    <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#Analyst"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <ns1:identifier rdf:datatype="http://www.w3.org/2001/XMLSchema#string">analyst</ns1:identifier>
    <ns1:makesDecision rdf:resource="https://example.org/lnu/energy-visualization#decision"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/lnu/energy-visualization#forecast">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#NamedIndividual"/>
    <rdf:type rdf:resource="https://example.org/lnu/energy-visualization#ForecastResult"/>
    <rdfs:label xml:lang="uk">Прогноз із ЛР1</rdfs:label>
    <ns1:forecastKwh rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">1.9519405504171758</ns1:forecastKwh>
    <ns1:evaluatedBy rdf:resource="https://example.org/lnu/energy-visualization#mae"/>
